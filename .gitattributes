# Normalize line endings: LF in the repo and working tree, except Windows scripts.
* text=auto eol=lf
*.sh  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git hooks have no extension; keep them LF so Git Bash can run them.
.githooks/* text eol=lf

# Unity text assets (Force Text serialization)
*.unity  text eol=lf
*.prefab text eol=lf
*.asset  text eol=lf
*.meta   text eol=lf
*.mat    text eol=lf

# Binaries (Git LFS will be introduced for art and audio in M1, decision pending)
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.zip binary
