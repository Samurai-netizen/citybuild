<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP host and composition root of the server (docs/modules/CityBuilder.Api.md). The settings every server project shares are in
       ../../Directory.Build.props, the package versions in ../../Directory.Packages.props. -->

  <!-- user-secrets hold the settings that must never be committed, such as the database connection string (docs/getting-started.md →
       Database); in Development ASP.NET Core reads them by this id. -->
  <PropertyGroup>
    <UserSecretsId>citybuilder-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Only for dotnet-ef at design time (Api is its startup project); nothing of it ships with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!-- The content files (core-instructions/03-architecture.md, content pipeline) go to content/ next to the app; the configuration key
       Content:FilePath names the one the server loads. Projects that reference Api (the tests) get the copy too. -->
  <ItemGroup>
    <None Include="..\..\content\*.json" Link="content\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CityBuilder.Application\CityBuilder.Application.csproj" />
    <ProjectReference Include="..\CityBuilder.Infrastructure\CityBuilder.Infrastructure.csproj" />
  </ItemGroup>

</Project>
