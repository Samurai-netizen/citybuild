<Project>
  <!-- Central package management: every NuGet version used under server/ is pinned here, and restore writes a
       packages.lock.json per project (core-instructions/14-coding-standards.md). Only packages on the approved list
       in 14 may be added; anything else needs G-Dependency (core-instructions/15-change-control.md). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Design-time support for the dotnet-ef tool (migrations); the tool's own version is pinned in dotnet-tools.json at the repo root. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>

  <!-- EF Core on PostgreSQL (core-instructions/06-data-model.md). The provider accepts any EF Core 10 from 10.0.4; the explicit
       Relational reference keeps EF Core on one patch version with the Design package. -->
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- xUnit v3 without Microsoft Testing Platform (xunit.v3.mtp-off) runs under VSTest, so the dotnet test commands with a
       Category filter work as in CI. The default xunit.v3 package fails under VSTest on the .NET 10 SDK.
       Owner approval 2026-10-12 (build log of M0-02, decision row 019 in core-instructions/12-decisions.md). -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Microsoft's C# parser, for the documentation checks of CityBuilder.Repository.Tests (syntax only; owner approval 2026-10-26, CR-0003). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- One real PostgreSQL container per integration test run (docs/testing/README.md); on the approved list in 14. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>
</Project>
