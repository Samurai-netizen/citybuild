<Project>
  <!-- Build settings shared by every project under server/ (core-instructions/14-coding-standards.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The project's folder relative to server/, e.g. "src/CityBuilder.Api" ("src\CityBuilder.Api" on Windows). -->
  <PropertyGroup>
    <ServerProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</ServerProjectFolder>
  </PropertyGroup>

  <!-- Production code: any warning fails the build. Tests under tests/ report warnings without failing. -->
  <PropertyGroup Condition="$(ServerProjectFolder.StartsWith('src'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Every project writes its XML doc file: only then does the compiler report IDE0005 (unnecessary usings) on build
       (https://github.com/dotnet/roslyn/issues/41640). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Every declaration has a doc comment (14 → Documentation in code, CR-0003). In src/ a missing one on a public member (CS1591) or a
       broken one fails the build like every other warning. In tests/ these warnings fail the build too: missing (CS1591), badly formed
       XML (CS1570), param and typeparam tags that don't match (CS1571-CS1573, CS1710-CS1712), paramref and typeparamref tags that
       name nothing (CS1734, CS1735), bad crefs (CS1574, CS1580, CS1581, CS1584, CS1658, CS1723), a doc comment in the wrong place
       (CS1587) and broken includes (CS1589, CS1590, CS1592). -->
  <PropertyGroup Condition="$(ServerProjectFolder.StartsWith('tests'))">
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</WarningsAsErrors>
  </PropertyGroup>
</Project>
