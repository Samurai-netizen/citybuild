<Project>
  <!-- Build settings shared by every project under server/ (core-instructions/14-coding-standards.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The project's folder relative to server/, e.g. "src/CityBuilder.Api" ("src\CityBuilder.Api" on Windows). -->
  <PropertyGroup>
    <ServerProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</ServerProjectFolder>
  </PropertyGroup>

  <!-- Production code: any warning fails the build. Tests under tests/ report warnings without failing. -->
  <PropertyGroup Condition="$(ServerProjectFolder.StartsWith('src'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Every project writes its XML doc file: only then does the compiler report IDE0005 (unnecessary usings) on build
       (https://github.com/dotnet/roslyn/issues/41640). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Every declaration has a doc comment (14 → Documentation in code, CR-0003). In src/ a missing one on a public member (CS1591) fails
       the build like every other warning. The test projects still suppress it until CR-0003-T1 has documented them. -->
  <PropertyGroup Condition="$(ServerProjectFolder.StartsWith('tests'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
