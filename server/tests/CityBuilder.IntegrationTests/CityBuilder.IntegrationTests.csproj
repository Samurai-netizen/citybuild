<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the server running in process (WebApplicationFactory): the host, content loading and the dependency rule of
       Infrastructure without a database, and persistence against a real PostgreSQL container (Testcontainers, Category=Integration;
       core-instructions/08-testing-strategy.md, test layers; docs/testing/README.md). -->

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CityBuilder.Api\CityBuilder.Api.csproj" />
  </ItemGroup>

  <!-- The metrics report tool (CR-0009-T2), for the PostgreSQL tests of its loader (Metrics/). The alias keeps the tool's Program apart
       from the Api's, which WebApplicationFactory<Program> names. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\tools\MetricsReport\MetricsReport.csproj" Aliases="MetricsTool" />
  </ItemGroup>

  <!-- Golden scenario #1's frozen content, the engine test's own file linked (never copied: one frozen file, protected in
       core-instructions/15-change-control.md), so the test over HTTP (Golden/) loads exactly what the engine test loads. -->
  <ItemGroup>
    <None Include="..\CityBuilder.Simulation.Tests\Fixtures\content-golden-v2.json" Link="Fixtures\content-golden-v2.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The end-to-end suite's frozen content (M0-B decision 3): content mvp-3 as it was on 2026-11-17, so a balance change can't
       rewrite the suite's expectations. Never edit it; a new content model gets a new file. -->
  <ItemGroup>
    <None Include="Fixtures\content-e2e-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The server panel's goods script (CR-0006), the file itself linked, so GoodsPanelScriptTests run what panel.sh runs. -->
  <ItemGroup>
    <None Include="..\..\..\server-panel\goods.sql" Link="server-panel\goods.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
