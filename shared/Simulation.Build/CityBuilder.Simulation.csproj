<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity package's sources with the .NET SDK, so the server and its tests run exactly the code Unity compiles.
       The project sits beside the package, not inside it: Unity imports every file of a package folder, including bin/ and obj/
       (core-instructions/03-architecture.md). It is outside server/, so it inherits nothing from server/Directory.Build.props and
       repeats the settings that matter: netstandard2.1 and C# 9 are what Unity 6.3 compiles (.claude/rules/simulation.md).
       Nullable annotations come from "#nullable enable" at the top of every source file, because Unity does not read this file.
       The engine references only the base class library: no packages, so no lock file (build log of M0-03, decision 5). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Simulation/Runtime/**/*.cs" />
  </ItemGroup>

  <!-- Checks the settings after every import has been evaluated. A Directory.Build.targets file or a -p: override on the command line
       would change them behind the tests' back: a text check of this file cannot see that, and C# 10 syntax would then pass the .NET
       build and break Unity (build log of M0-03, decision 16). -->
  <Target Name="GuardUnityCompatibleBuild" BeforeTargets="CoreCompile">
    <Error Condition="'$(TargetFramework)' != 'netstandard2.1' Or '$(LangVersion)' != '9.0' Or '$(TreatWarningsAsErrors)' != 'true'"
           Text="CityBuilder.Simulation must build as netstandard2.1, C# 9.0 and with warnings as errors, because Unity compiles the same sources (.claude/rules/simulation.md)." />
  </Target>

</Project>
