# The settings of the development database in docker-compose.yml. Copy this file to .env (gitignored) and pick your own password.
# The API's connection string uses the same values (docs/getting-started.md → Database).
POSTGRES_USER=citybuilder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citybuilder
# The port on this machine (optional, default 5432).
POSTGRES_PORT=5432
