#!/usr/bin/env bash
# Git commit-msg hook: enforces "<type>(<ID>): <summary>" (core-instructions/18-git-and-ci.md).
msg_file="$1"
subject="$(head -n1 "$msg_file")"

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|test|docs|refactor|perf|build|ci|chore|wip)\((M[0-9]+-[0-9]{2}|CR-[0-9]{4}(-T[0-9]+)?|repo|kit)\)!?: .{3,}$'
if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  echo "commit-msg: subject must look like  feat(M0-15): short summary" >&2
  echo "  types: feat fix test docs refactor perf build ci chore wip" >&2
  echo "  id:    task (M0-15), change request (CR-0007 or CR-0007-T1), or repo/kit for owner maintenance" >&2
  echo "  got:   $subject" >&2
  exit 1
fi
if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: subject is ${#subject} characters (max 100)." >&2
  exit 1
fi
exit 0
