# What git ignores in the whole repository; client/CityBuilder/.gitignore adds the Unity project's own ignores.

# --- secrets and local settings (never commit) ---
.env
*.local.json
CLAUDE.local.md
.claude/settings.local.json
.local/
game-description/
landing/

# --- .NET ---
bin/
obj/
*.user
*.suo
TestResults/
coverage*/
*.trx

# --- IDEs and OS ---
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Docker volumes (local) ---
.data/

# --- handbook site (website/README.md) ---
website/node_modules/
website/build/
website/.docusaurus/

# --- tool output ---
artifacts/
*.log
# Unity-specific ignores live in client/CityBuilder/.gitignore (created in M0-04).
# Do NOT ignore *.csproj or *.sln here: the server needs them.

# --- art (art/README.md): renders the Blender build rewrites; only the README/MOTIONS pictures and GIFs are tracked ---
art/previews/*
!art/previews/city_closeup.png
!art/previews/city_golden_scenario.png
!art/previews/*.jpg
!art/previews/motion/
art/previews/motion/*
!art/previews/motion/*.gif
art/ui/city_phone.png
art/ui/preview/shots/
__pycache__/
