# Unity-specific ignores. They live here, not in the root .gitignore, because the root must not
# ignore *.csproj (the server needs them). See core-instructions/09-unity-client.md.
# Commit every .meta file, Packages/manifest.json, Packages/packages-lock.json and ProjectSettings/.

# Generated by the Editor (anchored: Unity writes these only at the project root)
/Library/
/Temp/
/Logs/
/UserSettings/
/obj/
/MemoryCaptures/
/Recordings/

# Player builds
/Build/
/Builds/
*.apk
*.aab
*.unitypackage
*.app

# Generated IDE projects (Unity rewrites them; "Assembly-CSharp.csproj", "CityBuilder.slnx", ...)
*.csproj
*.sln
*.slnx

# Editor and crash leftovers
sysinfo.txt
crashlytics-build.session
*.pidb.meta
*.pdb.meta
*.mdb.meta
