<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The top HUD that HudView shows (M0-49; visual v2, CR-0008-T2): dark see-through chips over the map, like the UI showcase. The chip row
       holds one HudChip per item; the state row holds the free workers, the builders and the running research with its ring; the era's gold
       ribbon and the connection dot lead. HudView writes the HudModel's texts into the labels by name and sets the icons (UiIcons).
       Nothing here takes the pointer, so a drag that starts on the HUD still pans the ground. Style: Common.uss and Hud.uss.
       Era, chips and state sit side by side in landscape and are three rows in portrait, the ribbon on top (M0-59). -->
  <Style src="Common.uss" />
  <Style src="Hud.uss" />
  <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
    <ui:VisualElement name="hud-panel" class="hud-panel" picking-mode="Ignore">
      <ui:VisualElement class="hud-meta" picking-mode="Ignore">
        <ui:Label name="hud-era" class="hud-era ribbon" picking-mode="Ignore" />
        <ui:VisualElement class="hud-connection" picking-mode="Ignore">
          <ui:VisualElement name="hud-connection-dot" class="hud-dot" picking-mode="Ignore" />
          <ui:Label name="hud-connection-text" class="hud-caption" picking-mode="Ignore" />
      </ui:VisualElement>
        </ui:VisualElement>
      <ui:VisualElement name="hud-chips" class="hud-chips" picking-mode="Ignore" />
      <ui:VisualElement name="hud-state" class="hud-state" picking-mode="Ignore">
        <ui:VisualElement class="hud-stat chip-dark" picking-mode="Ignore">
          <ui:VisualElement name="hud-workers-icon" class="hud-stat-icon" picking-mode="Ignore" />
          <ui:Label name="hud-workers" class="hud-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-stat chip-dark" picking-mode="Ignore">
          <ui:VisualElement name="hud-builders-icon" class="hud-stat-icon" picking-mode="Ignore" />
          <ui:Label name="hud-builders" class="hud-value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-research chip-dark" picking-mode="Ignore">
          <ui:VisualElement name="hud-ring" class="hud-ring" picking-mode="Ignore">
            <ui:VisualElement class="hud-ring-hole" picking-mode="Ignore">
              <ui:VisualElement name="hud-ring-icon" class="hud-ring-icon" picking-mode="Ignore" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="hud-research-text" picking-mode="Ignore">
            <ui:Label name="hud-research-name" class="hud-research-name" picking-mode="Ignore" />
            <ui:Label name="hud-research-time" class="hud-research-time" picking-mode="Ignore" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
