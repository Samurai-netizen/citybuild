/* The top HUD (docs/how-to/add-ui-screen.md): one wood bar across the top. M0-49, restyled in CR-0007. Colours and sizes come from Common.uss. The bar is
   40 high plus its border and the gap below: --hud-height in Common.uss is where every screen under the HUD starts. It takes no pointer. */
.hud-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-start;
}

.hud-panel {
  height: 40px;
  padding: 0 var(--sp-2);
  flex-direction: row;
  align-items: center;
}

.hud-chips {
  flex-direction: row;
  align-items: center;
}

.hud-chip {
  flex-direction: row;
  align-items: center;
  height: 32px;
  margin: 0 var(--sp-1) 0 0;
  padding: 0 var(--sp-2) 0 var(--sp-1);
  border-width: 1px;
  border-radius: var(--radius-sm);
  border-color: transparent;
  background-color: var(--c-wood-deep-2);
}

.hud-chip--full {
  border-color: var(--c-warn);
}

.hud-chip-icon {
  width: 24px;
  height: 24px;
  margin: 0 var(--sp-1) 0 0;
  border-radius: 12px;
  background-color: var(--c-wood-dark);
  color: var(--c-cream);
  font-size: var(--font-md);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

/* An item with a picture: the picture replaces the circle and the letter. */
.hud-chip-icon--picture {
  border-radius: 0;
  background-color: transparent;
  -unity-background-scale-mode: scale-to-fit;
}

.hud-chip-text {
  flex-direction: column;
  justify-content: center;
}

.hud-chip-amount {
  flex-direction: row;
  align-items: flex-end;
}

.hud-value {
  margin: 0;
  padding: 0;
  color: var(--c-cream);
  font-size: var(--font-md);
  -unity-font-style: bold;
}

.hud-caption {
  margin: 0 0 0 var(--sp-1);
  padding: 0;
  color: var(--c-cream-soft);
  font-size: var(--font-xs);
}

.hud-rate {
  margin: 0;
  padding: 0;
  font-size: var(--font-xs);
  color: var(--c-cream-soft);
}

.hud-rate--rising {
  color: var(--c-go-light);
}

.hud-rate--falling {
  color: var(--c-stop-light);
}

.hud-stat {
  flex-direction: row;
  align-items: center;
  margin: 0 var(--sp-2) 0 var(--sp-1);
}

.hud-stat-icon {
  width: 22px;
  height: 22px;
  margin: 0 var(--sp-1) 0 0;
  -unity-background-scale-mode: scale-to-fit;
}

.hud-research {
  flex-direction: row;
  align-items: center;
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  margin: 0 var(--sp-1);
}

.hud-ring {
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  margin: 0 var(--sp-2) 0 0;
}

/* The research picture sits in the middle of the ring that the painter draws on .hud-ring. */
.hud-ring-icon {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 18px;
  height: 18px;
  -unity-background-scale-mode: scale-to-fit;
}

.hud-research-text {
  flex-direction: column;
  flex-shrink: 1;
  min-width: 0;
}

.hud-research-text .hud-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hud-research-text .hud-caption {
  margin: 0;
}

.hud-meta {
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.hud-era {
  margin: 0;
  padding: 0 var(--sp-2);
  border-radius: var(--radius-sm);
  border-width: 1px;
  border-color: var(--c-gold);
  color: var(--c-gold);
  font-size: var(--font-xs);
  -unity-font-style: bold;
}

.hud-connection {
  flex-direction: row;
  align-items: center;
  margin-top: 2px;
}

.hud-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: var(--c-cream-soft);
}

.hud-dot--ok {
  background-color: var(--c-go-light);
}

.hud-dot--pending {
  background-color: var(--c-warn);
}

.hud-dot--problem {
  background-color: var(--c-stop-light);
}
