/* The welcome-back report (M0-53, docs/how-to/add-ui-screen.md): a parchment card in the middle of a dark scrim. Restyled in CR-0007; colours and sizes
   come from Common.uss. */
.welcome-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.welcome-scrim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  justify-content: center;
  align-items: center;
}

.welcome-scrim--hidden {
  display: none;
}

.welcome-card {
  width: 440px;
  max-width: 100%;
  max-height: 100%;
}

.welcome-title {
  flex-shrink: 0;
}

.welcome-scroll {
  flex-shrink: 1;
  margin-top: var(--sp-2);
}

.welcome-sections {
  flex-direction: column;
}

.welcome-heading {
  margin-top: var(--sp-2);
  color: var(--c-ink-soft);
  font-size: var(--font-md);
  -unity-font-style: bold;
}

.welcome-line {
  margin-top: 2px;
  color: var(--c-ink);
  font-size: var(--font-md);
  white-space: normal;
}

.welcome-empty {
  margin-top: var(--sp-2);
}

.welcome-cap-note {
  flex-shrink: 0;
  margin-top: var(--sp-2);
  padding: var(--sp-2);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  border-left-color: var(--c-warn);
  color: var(--c-warn-ink);
  background-color: var(--c-parchment-2);
  font-size: var(--font-sm);
  white-space: normal;
}

.welcome-continue {
  flex-shrink: 0;
  margin-top: var(--sp-3);
}
