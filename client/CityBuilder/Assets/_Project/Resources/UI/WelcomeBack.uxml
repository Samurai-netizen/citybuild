<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The welcome-back report that WelcomeBackPanel shows (M0-53, docs/how-to/add-ui-screen.md): a parchment card in the middle of a dark scrim with the
       title, the sections (WelcomeBackPanel makes one heading and its lines per section), the production-cap note and a Continue button. The
       scrim takes the pointer, so the ground and the other menus leave the screen alone until the player continues. Style: Common.uss and WelcomeBack.uss. -->
  <Style src="Common.uss" />
  <Style src="WelcomeBack.uss" />
  <ui:VisualElement name="welcome-root" class="welcome-root" picking-mode="Ignore">
    <ui:VisualElement name="welcome-scrim" class="welcome-scrim scrim welcome-scrim--hidden">
      <ui:VisualElement name="welcome-card" class="welcome-card panel-parchment">
        <ui:Label name="welcome-title" class="welcome-title t-title" />
        <ui:ScrollView name="welcome-scroll" class="welcome-scroll themed-scroll" mode="Vertical">
          <ui:VisualElement name="welcome-sections" class="welcome-sections" />
          <ui:Label name="welcome-empty" class="welcome-empty t-body" />
        </ui:ScrollView>
        <ui:Label name="welcome-cap-note" class="welcome-cap-note" />
        <ui:Button name="welcome-continue" class="welcome-continue btn btn--primary" text="Continue" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
