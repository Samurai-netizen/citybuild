<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- One item chip of the HUD (M0-49; visual v2, CR-0009): a dark pill with the item's big picture on its left edge, the stock in the
       display font with the cap after it, and the rate per hour under it, green when it rises and red when it falls. HudView clones it once
       per item and writes the texts of ItemChipModel into the labels by name; when the item has no picture, the icon label shows its first
       letter. Its style is in Hud.uss. -->
  <ui:VisualElement name="hud-chip" class="hud-chip chip-dark" picking-mode="Ignore">
    <ui:Label name="hud-chip-icon" class="hud-chip-icon" picking-mode="Ignore" />
    <ui:VisualElement class="hud-chip-text" picking-mode="Ignore">
      <ui:VisualElement class="hud-chip-amount" picking-mode="Ignore">
        <ui:Label name="hud-chip-stock" class="hud-value" picking-mode="Ignore" />
        <ui:Label name="hud-chip-cap" class="hud-caption" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:Label name="hud-chip-rate" class="hud-rate" picking-mode="Ignore" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
