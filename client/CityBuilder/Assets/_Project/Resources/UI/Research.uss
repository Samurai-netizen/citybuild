/* The research screen (M0-52, docs/how-to/add-ui-screen.md): a button at the bottom left next to the Build button and, above it, a parchment panel with
   the era header and the columns of nodes. Restyled in CR-0007; colours and sizes come from Common.uss. */
.research-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
}

.research-panel {
  align-self: stretch;
  flex-grow: 1;
  margin-top: var(--hud-height);
  margin-bottom: var(--sp-2);
}

.research-panel--hidden {
  display: none;
}

.research-header {
  flex-direction: row;
  align-items: center;
}

.research-titles {
  flex-grow: 1;
  flex-shrink: 1;
}

.research-rule--off {
  opacity: 0.7;
}

.research-scroll {
  flex-grow: 1;
  margin-top: var(--sp-2);
}

.research-columns {
  flex-direction: row;
  align-items: flex-start;
}

.research-column {
  width: 330px;
  margin-right: var(--sp-2);
}

.research-node {
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--sp-2);
  padding: var(--sp-2);
  border-width: 2px;
  border-radius: var(--radius-md);
  border-color: var(--c-parchment-3);
  background-color: var(--c-parchment-2);
}

.research-node--locked {
  opacity: 0.6;
}

.research-node--available {
  border-color: var(--c-info);
}

.research-node--running {
  border-color: var(--c-gold);
  border-width: 3px;
}

.research-node--done {
  border-color: var(--c-go);
}

.research-node-text {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  flex-direction: column;
}

.research-node-header {
  flex-direction: row;
  align-items: center;
}

.research-node-icon {
  width: 28px;
  height: 28px;
  margin-right: var(--sp-2);
  -unity-background-scale-mode: scale-to-fit;
}

.research-node-name {
  flex-grow: 1;
  flex-shrink: 1;
}

.research-node-ring {
  width: 28px;
  height: 28px;
  margin-left: var(--sp-1);
}

.research-node-numbers {
  flex-direction: row;
  flex-wrap: wrap;
}

.research-node-cost {
  margin-right: var(--sp-3);
}

.research-node-status {
  color: var(--c-ink);
  font-size: var(--font-sm);
  -unity-font-style: bold;
  white-space: normal;
}

.research-toggle {
  min-width: var(--dock-width);
  margin-left: var(--dock-next);
}

.research-node-finance {
  min-width: 80px;
  margin-left: var(--sp-2);
}
