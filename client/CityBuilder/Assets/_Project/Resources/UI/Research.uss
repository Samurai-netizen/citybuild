/* The research screen (M0-52, docs/how-to/add-ui-screen.md): a button at the bottom left next to the Build button and, above it, a parchment panel with
   the era header and the list of nodes (one row of cards, CR-0007). Restyled in CR-0007; colours and sizes come from Common.uss. */
.research-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
}

.research-panel {
  align-self: stretch;
  flex-grow: 1;
  margin-top: var(--hud-height);
  margin-bottom: var(--sp-2);
  padding: var(--sp-2);
}

.research-panel--hidden {
  display: none;
}

.research-header {
  flex-direction: row;
  align-items: center;
}

.research-titles {
  flex-grow: 1;
  flex-shrink: 1;
  flex-direction: row;
  align-items: flex-end;
}

.research-rule {
  margin: 0 0 2px var(--sp-3);
}

.research-rule--off {
  opacity: 0.7;
}

.research-close {
  display: none; /* the Close button under the panel closes it, as for the build tray: the header's height is the title's */
}

.research-scroll {
  flex-grow: 1;
  margin-top: var(--sp-1);
}

/* The scrollbar lies over the bottom edge of the cards instead of taking height from them. */
.research-scroll .unity-scroll-view__horizontal-scroller {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  margin-top: 0;
}

.research-columns {
  flex-direction: row;
}

.research-row {
  flex-direction: row;
  align-items: flex-start;
}

/* A research card: the name, the big picture (about 60% of the card) and the text lines; the Finance button is laid over the whole card. */
.research-node {
  width: 200px;
  height: 220px;
  margin-right: var(--sp-2);
  padding: 6px;
  flex-direction: column;
  border-width: 2px;
  border-radius: var(--radius-md);
  border-color: var(--c-parchment-3);
  background-color: var(--c-parchment-2);
}

.research-node--locked {
  opacity: 0.6;
}

.research-node--available {
  border-color: var(--c-info);
}

.research-node--running {
  border-color: var(--c-gold);
  border-width: 3px;
}

.research-node--done {
  border-color: var(--c-go);
}

.research-node--ready {
  border-color: var(--c-go);
  border-width: 3px;
}

.research-node-name {
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -unity-text-align: middle-center;
}

.research-node-art {
  height: 124px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.research-node-icon {
  width: 124px;
  height: 124px;
  -unity-background-scale-mode: scale-to-fit;
}

.research-node-ring {
  position: absolute;
  right: 0;
  top: 0;
  width: 32px;
  height: 32px;
}

.research-node-lines {
  flex-grow: 1;
  flex-shrink: 1;
  overflow: hidden;
  flex-direction: column;
}

/* The chips sit over the picture: the time at the top left, the cost at the bottom (the first child is the lowest). */
.research-node-numbers {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  flex-direction: column-reverse;
  justify-content: space-between;
  align-items: flex-start;
}

.research-node-chip {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 var(--sp-1);
  border-radius: var(--radius-sm);
  background-color: var(--c-parchment-3);
  color: var(--c-ink);
  font-size: var(--font-xs);
  -unity-font-style: bold;
  white-space: nowrap;
}

.research-node-note {
  flex-shrink: 0;
  color: var(--c-warn-ink);
  font-size: var(--font-xs);
  -unity-font-style: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.research-node-effect,
.research-node-status {
  flex-shrink: 0;
}

.research-node-status {
  color: var(--c-ink);
  font-size: var(--font-sm);
  -unity-font-style: bold;
  white-space: normal;
}

.research-toggle {
  min-width: var(--dock-width);
  margin-left: var(--dock-next);
}

/* The Finance button covers the whole card and shows nothing of its own: the card is the thing to tap. */
.research-node-finance,
.research-node-finance:hover,
.research-node-finance:active {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  min-width: 0;
  min-height: 0;
  padding: 0;
  border-width: 0;
  border-radius: var(--radius-md);
  background-color: transparent;
  color: transparent;
}

.research-node-finance:active {
  background-color: var(--c-shade);
}
