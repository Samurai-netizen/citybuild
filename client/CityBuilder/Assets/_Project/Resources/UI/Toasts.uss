/* The toasts (docs/how-to/add-ui-screen.md): short messages stacked at the bottom left, above the status label and the buttons (the top has the HUD, the banner and the inspector). M0-47, restyled in CR-0007. A toast is a dark wood pill
   with cream text and a coloured edge: green for a success, red for an error. */
.toast-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
}

.toast-list {
  margin-bottom: var(--toast-lift);
  flex-direction: column;
  align-items: flex-start;
}

.toast {
  max-width: 280px; /* ends before the inspector, which starts 313 units from the left on a 711 unit wide screen */
  margin-bottom: var(--sp-1);
  padding: var(--sp-1) var(--sp-3);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  color: var(--c-cream);
  background-color: var(--c-panel-wood);
  font-size: var(--font-md);
  white-space: normal;
  -unity-text-align: middle-left;
}

.toast--success {
  border-left-color: var(--c-go-light);
}

.toast--error {
  border-left-color: var(--c-stop-light);
}
