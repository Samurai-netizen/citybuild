/* The toasts (docs/how-to/add-ui-screen.md): short messages at the top centre, under the HUD (M0-49). M0-47. Sizes are in panel units (reference resolution
   1200 x 800). Success is green, an error is red, both on a dark pill with white text so they read over any ground. */
.toast-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 16px;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.toast-list {
  margin-top: 224px; /* clears the HUD; the root's padding is replaced by the safe area in code, a margin is not */
  flex-direction: column;
  align-items: center;
}

.toast {
  max-width: 640px;
  margin-bottom: 8px;
  padding: 10px 20px;
  border-radius: 10px;
  border-left-width: 6px;
  color: rgb(255, 255, 255);
  background-color: rgba(0, 0, 0, 0.85);
  font-size: 24px;
  white-space: normal;
  -unity-text-align: middle-center;
}

.toast--success {
  border-left-color: rgb(90, 190, 110);
}

.toast--error {
  border-left-color: rgb(235, 100, 85);
}
