<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- One card of the build menu (M0-45; visual v2, CR-0009): a cream card framed in wood with the building's big picture on top (UiIcons),
       its name, what it costs and takes, its workers and recipe, and why it can't be built yet. BuildMenu clones it once per building type
       and writes the texts of BuildCardModel into the labels by name. Its style is in BuildMenu.uss and Common.uss. -->
  <ui:VisualElement name="card" class="build-card">
    <ui:VisualElement name="card-icon" class="card-icon" />
    <ui:Label name="card-name" class="card-name t-heading" />
    <ui:VisualElement class="card-costs">
      <ui:Label name="card-cost" class="card-cost" />
      <ui:Label name="card-time" class="card-time glyph-time" />
    </ui:VisualElement>
    <ui:Label name="card-workers" class="card-line t-small" />
    <ui:Label name="card-recipe" class="card-line card-recipe" />
    <ui:Label name="card-lock" class="card-lock glyph-lock" />
    <ui:Label name="card-hint" class="card-hint" />
  </ui:VisualElement>
</ui:UXML>
