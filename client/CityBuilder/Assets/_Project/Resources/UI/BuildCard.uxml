<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- One card of the build menu (docs/how-to/add-ui-screen.md): BuildMenu clones it once per building type and writes the texts of
       BuildCardModel into the labels by name. Its style is in BuildMenu.uss. -->
  <ui:VisualElement name="card" class="build-card">
    <ui:Label name="card-name" class="card-name" />
    <ui:Label name="card-cost" class="card-line" />
    <ui:Label name="card-time" class="card-line" />
    <ui:Label name="card-workers" class="card-line" />
    <ui:Label name="card-recipe" class="card-line card-recipe" />
    <ui:Label name="card-lock" class="card-lock" />
    <ui:Label name="card-hint" class="card-hint" />
  </ui:VisualElement>
</ui:UXML>
