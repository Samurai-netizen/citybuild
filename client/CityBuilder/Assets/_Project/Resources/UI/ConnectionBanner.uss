/* The connection banner and the blocking screen (M0-55, docs/how-to/add-ui-screen.md), restyled in CR-0007: parchment on wood, colours and sizes from
   Common.uss. The banner sits under the HUD at the left and ends before the inspector (which sits at the right). */
.connection-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
}

.connection-banner {
  width: 290px;
  max-width: 100%;
  margin-top: var(--hud-height);
  flex-direction: column;
  border-left-width: 6px;
  border-left-color: var(--c-warn);
}

.connection-banner--hidden {
  display: none;
}

.connection-message {
  color: var(--c-ink);
  font-size: var(--font-md);
  -unity-font-style: bold;
  white-space: normal;
}

.connection-banner-row {
  margin-top: var(--sp-1);
  flex-direction: row;
  align-items: center;
}

.connection-synced {
  flex-grow: 1;
  flex-shrink: 1;
}

.connection-button {
  min-width: 96px;
  margin-left: var(--sp-2);
}

.connection-blocker {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  justify-content: center;
  align-items: center;
}

.connection-blocker--hidden {
  display: none;
}

.connection-card {
  width: 340px;
  max-width: 100%;
}

.connection-blocker-message {
  margin-top: var(--sp-2);
}

.connection-blocker-button {
  margin-top: var(--sp-3);
  align-self: flex-end;
}
