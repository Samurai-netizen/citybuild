<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The research screen that ResearchScreen shows (M0-52, docs/how-to/add-ui-screen.md): a "Research" button at the bottom left, next to
       the Build button, that opens a parchment panel with the era header, the rule line and the columns of research nodes (ResearchNode.uxml is one
       node; ResearchScreen makes one per node of the era and puts it into the column of its prerequisites). Style: Common.uss and Research.uss. -->
  <Style src="Common.uss" />
  <Style src="Research.uss" />
  <ui:VisualElement name="research-root" class="research-root" picking-mode="Ignore">
    <ui:VisualElement name="research-panel" class="research-panel panel-parchment research-panel--hidden">
      <ui:VisualElement class="research-header">
        <ui:VisualElement class="research-titles">
          <ui:Label name="research-era" class="t-title" />
          <ui:Label name="research-rule" class="research-rule t-small" />
        </ui:VisualElement>
        <ui:Button name="research-close" class="research-close btn btn--quiet" text="X" />
      </ui:VisualElement>
      <ui:ScrollView name="research-scroll" class="research-scroll themed-scroll" mode="VerticalAndHorizontal">
        <ui:VisualElement name="research-columns" class="research-columns" />
      </ui:ScrollView>
    </ui:VisualElement>
    <ui:Button name="research-toggle" class="research-toggle btn" text="Research" />
  </ui:VisualElement>
</ui:UXML>
