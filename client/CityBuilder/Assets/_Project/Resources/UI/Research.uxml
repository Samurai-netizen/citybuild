<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The research screen that ResearchScreen shows (M0-52; visual v2, CR-0009): the gold Research button of the dock, with the book's
       picture, opens a parchment sheet with the era as its title, the one-at-a-time rule and the research nodes as one row of cards
       (ResearchNode.uxml is one node; ResearchScreen makes one per node of the era and puts them in the row in the model's order). The row
       scrolls sideways only; when the sheet is lower than a card, ResearchScreen scales the row down until it fits (OD-17, M0-59).
       Style: Common.uss and Research.uss. -->
  <Style src="Common.uss" />
  <Style src="Research.uss" />
  <ui:VisualElement name="research-root" class="research-root" picking-mode="Ignore">
    <ui:VisualElement name="research-panel" class="research-panel panel-parchment research-panel--hidden">
      <ui:VisualElement class="research-header">
        <ui:VisualElement class="research-titles">
          <ui:Label name="research-era" class="t-title" />
          <ui:Label name="research-rule" class="research-rule t-small" />
        </ui:VisualElement>
        <ui:Button name="research-close" class="research-close btn btn--round glyph glyph-close" text="" />
      </ui:VisualElement>
      <ui:ScrollView name="research-scroll" class="research-scroll themed-scroll" mode="Horizontal">
        <ui:VisualElement name="research-columns" class="research-columns" />
      </ui:ScrollView>
    </ui:VisualElement>
    <ui:Button name="research-toggle" class="research-toggle btn btn--gold btn--dock" text="Research" />
  </ui:VisualElement>
</ui:UXML>
