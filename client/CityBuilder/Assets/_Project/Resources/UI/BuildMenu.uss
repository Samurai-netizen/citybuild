/* The build menu (M0-45; visual v2, CR-0008-T2): the green Build button at the bottom left, with the builders' picture, and above it a
   parchment sheet with a title and a sideways row of cream cards framed in wood, like the showcase's build sheet. Colours and sizes come
   from Common.uss. */
.build-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
}

.build-toggle {
  width: var(--dock-width);
  background-image: url("Icons/builders.png");
}

.build-panel {
  align-self: stretch;
  margin-bottom: var(--sp-2);
}

.build-panel--hidden {
  display: none;
}

.build-header {
  flex-direction: row;
  align-items: flex-end;
  margin: 0 0 var(--sp-1) var(--sp-1);
}

.build-header-note {
  margin: 0 0 3px var(--sp-3);
}

.build-roads {
  margin-left: auto;
  padding-left: var(--sp-3);
  padding-right: var(--sp-3);
}

.build-header .t-title {
  font-size: var(--font-lg);
}

.build-cards {
  min-height: 172px;
}

.build-card {
  width: 204px;
  flex-shrink: 0;
  margin: 0 var(--sp-2) var(--sp-1) 0;
  padding: var(--sp-1) var(--sp-3) var(--sp-3);
  border-width: 3px;
  border-bottom-width: 6px;
  border-radius: 18px;
  border-color: var(--c-wood);
  background-color: var(--c-cream);
}

.build-card--selected {
  border-color: var(--c-gold-line);
  background-color: var(--c-gold-soft);
}

.build-card--locked {
  border-color: var(--c-off-edge);
  background-color: var(--c-locked);
}

.build-card:disabled {
  opacity: 0.85;
}

.card-icon {
  width: 64px;
  height: 64px;
  align-self: center;
  margin: -2px 0 -4px 0;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.build-card--locked .card-icon {
  opacity: 0.55;
}

.card-name {
  flex-shrink: 0;
  font-size: var(--font-lg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-costs {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 2px;
}

.card-cost {
  -unity-font-definition: url("Fonts/Fredoka-SemiBold.ttf");
  flex-shrink: 1;
  margin: 0 var(--sp-2) 2px 0;
  white-space: normal;
  padding: 1px var(--sp-2);
  border-radius: 10px;
  background-color: var(--c-card);
  color: var(--c-ink);
  font-size: var(--font-sm);
}

.card-time {
  padding-left: 16px;
  color: var(--c-ink-soft);
  font-size: var(--font-sm);
  background-size: 13px 13px;
  background-repeat: no-repeat no-repeat;
  background-position-x: left 0px;
  background-position-y: center;
  -unity-background-image-tint-color: var(--c-ink-soft);
}

.card-line {
  margin-top: 2px;
  font-size: var(--font-sm);
}

.card-recipe {
  -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
  color: var(--c-go-ink);
  white-space: normal;
}

.card-lock {
  margin-top: var(--sp-1);
  padding-left: 18px;
  color: var(--c-stop-ink);
  font-size: var(--font-sm);
  white-space: normal;
  background-size: 14px 14px;
  background-repeat: no-repeat no-repeat;
  background-position-x: left 0px;
  background-position-y: center;
  -unity-background-image-tint-color: var(--c-stop-ink);
}

/* Portrait: the screen is tall, so the cards get the showcase's big pictures; landscape keeps them compact under the HUD. */
.portrait .build-cards {
  min-height: 202px;
}

.portrait .build-card {
  width: 168px;
}

.portrait .card-icon {
  width: 92px;
  height: 92px;
}

.card-hint {
  -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
  margin-top: 2px;
  color: var(--c-stop-ink);
  font-size: var(--font-sm);
  white-space: normal;
}
