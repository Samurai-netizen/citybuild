/* The build menu (docs/how-to/add-ui-screen.md): a button at the bottom left and, above it, a wooden tray of parchment cards. M0-45, restyled in CR-0007.
   Colours and sizes come from Common.uss. */
.build-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
}

.build-toggle {
  min-width: var(--dock-width);
}

.build-panel {
  align-self: stretch;
  margin-bottom: var(--sp-2);
}

.build-panel--hidden {
  display: none;
}

.build-cards {
  min-height: 150px;
}

.build-card {
  width: 184px;
  margin: 0 var(--sp-2) 0 0;
  padding: var(--sp-2);
  border-width: 2px;
  border-radius: var(--radius-md);
  border-color: var(--c-parchment-3);
  background-color: var(--c-parchment);
}

.build-card--selected {
  border-color: var(--c-gold);
  border-width: 3px;
}

.build-card--locked {
  opacity: 0.55;
}

.card-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--sp-1);
}

.card-icon {
  width: 36px;
  height: 36px;
  margin-right: var(--sp-2);
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.card-name {
  flex-shrink: 1;
  font-size: var(--font-md);
}

.card-line {
  font-size: var(--font-sm);
}

.card-recipe {
  margin-top: var(--sp-1);
  color: var(--c-go);
  font-size: var(--font-sm);
  white-space: normal;
}

.card-lock {
  color: var(--c-stop);
  font-size: var(--font-sm);
  -unity-font-style: bold;
  white-space: normal;
}

.card-hint {
  margin-top: 2px;
}
