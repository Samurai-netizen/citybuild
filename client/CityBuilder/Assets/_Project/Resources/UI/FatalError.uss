/* The fatal error screen: a full-screen dark panel with a title and the lines of the error. M0-38 shows it for invalid server content. */
.fatal-error {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 32px;
  background-color: rgb(40, 12, 12);
}

.fatal-error-title {
  margin-bottom: 16px;
  color: rgb(255, 200, 200);
  font-size: 36px;
  -unity-font-style: bold;
}

.fatal-error-details {
  color: rgb(255, 255, 255);
  font-size: 22px;
  white-space: normal;
}
