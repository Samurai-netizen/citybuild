/* The connection status label: top left, readable on any background. M0-04 shows "Not connected"; M0-38 and M0-41 change the text. */
.connection-status {
  position: absolute;
  left: 16px;
  top: 16px;
  margin: 0;
  padding: 8px 14px;
  border-radius: 6px;
  background-color: rgba(0, 0, 0, 0.65);
  color: rgb(255, 255, 255);
  font-size: 24px;
}
