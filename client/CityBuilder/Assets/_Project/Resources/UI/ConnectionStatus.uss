/* The connection status label: bottom left above the Build button (the top belongs to the HUD since M0-49), readable on any background.
   M0-04 shows "Not connected"; M0-38 changes the text. */
.connection-status {
  position: absolute;
  left: 16px;
  bottom: 96px;
  margin: 0;
  padding: 8px 14px;
  border-radius: 6px;
  background-color: rgba(0, 0, 0, 0.65);
  color: rgb(255, 255, 255);
  font-size: 24px;
}
