<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The build menu that BuildMenu shows (M0-45; visual v2, CR-0008-T2): the green Build button of the dock, with the builders' picture, opens
       a parchment sheet above it with a title and one card per building type in a row that scrolls sideways; BuildCard.uxml is the card and
       its cards go into build-cards. Style: Common.uss and BuildMenu.uss. -->
  <Style src="Common.uss" />
  <Style src="BuildMenu.uss" />
  <ui:VisualElement name="build-root" class="build-root" picking-mode="Ignore">
    <ui:VisualElement name="build-panel" class="build-panel panel-parchment build-panel--hidden">
      <ui:VisualElement class="build-header">
        <ui:Label class="t-title" text="Build" />
        <ui:Label class="build-header-note t-small" text="Pick a building, then a free tile" />
      </ui:VisualElement>
      <ui:ScrollView name="build-cards" class="build-cards themed-scroll" mode="Horizontal" />
    </ui:VisualElement>
    <ui:Button name="build-toggle" class="build-toggle btn btn--primary btn--dock" text="Build" />
  </ui:VisualElement>
</ui:UXML>
