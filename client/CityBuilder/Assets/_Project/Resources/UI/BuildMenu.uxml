<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- The build menu that BuildMenu shows (docs/how-to/add-ui-screen.md): a "Build" button that opens a bottom sheet with one card per
       building type; BuildCard.uxml is the card and its cards go into build-cards. Style: Common.uss and BuildMenu.uss. -->
  <Style src="Common.uss" />
  <Style src="BuildMenu.uss" />
  <ui:VisualElement name="build-root" class="build-root" picking-mode="Ignore">
    <ui:VisualElement name="build-panel" class="build-panel panel-wood build-panel--hidden">
      <ui:ScrollView name="build-cards" class="build-cards themed-scroll" mode="Horizontal" />
    </ui:VisualElement>
    <ui:Button name="build-toggle" class="build-toggle btn btn--primary" text="Build" />
  </ui:VisualElement>
</ui:UXML>
