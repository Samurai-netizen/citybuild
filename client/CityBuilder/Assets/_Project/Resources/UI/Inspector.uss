/* The building inspector (M0-51; visual v2, CR-0009): a parchment panel framed in wood with boxes for the status, the workers and the
   upgrade, like the showcase's inspector; under the HUD at the right in landscape (two columns), a sheet above the dock in portrait (one
   column). Colours and sizes come from Common.uss. */
.inspector-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
}

.inspector-panel {
  width: 420px;
  max-width: 100%;
  margin-top: var(--hud-height);
}

.inspector-panel--hidden {
  display: none;
}

.inspector-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--sp-2);
}

.inspector-icon {
  width: 64px;
  height: 64px;
  margin: -14px var(--sp-2) -6px -6px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.inspector-titles {
  flex-grow: 1;
  flex-shrink: 1;
}

.inspector-close {
  margin-left: var(--sp-2);
}

.inspector-body {
  flex-direction: row;
}

.inspector-column {
  flex-grow: 1;
  flex-basis: 0;
  flex-direction: column;
}

.inspector-status-box {
  margin-bottom: var(--sp-2);
}

.inspector-status {
  color: var(--c-go-ink);
}

.inspector-workers-box {
  flex-direction: column;
}

.inspector-stepper {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.inspector-step {
  width: var(--touch);
  padding: 0;
}

.inspector-workers {
  -unity-font-definition: url("Fonts/Fredoka-SemiBold.ttf");
  min-width: 76px;
  color: var(--c-ink);
  font-size: var(--font-xxl);
  -unity-text-align: middle-center;
}

.inspector-preview {
  margin-top: var(--sp-1);
  -unity-text-align: middle-center;
}

.inspector-upgrade {
  margin-left: var(--sp-2);
}

.inspector-upgrade-cost {
  -unity-font-definition: url("Fonts/Fredoka-SemiBold.ttf");
  margin-top: 2px;
  color: var(--c-ink);
  font-size: var(--font-md);
  white-space: normal;
}

.inspector-upgrade-time {
  padding-left: 18px;
  background-size: 14px 14px;
  background-repeat: no-repeat no-repeat;
  background-position-x: left 0px;
  background-position-y: center;
  -unity-background-image-tint-color: var(--c-ink-soft);
}

.inspector-upgrade-note {
  -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
  margin-top: 2px;
  color: var(--c-stop-ink);
  font-size: var(--font-sm);
  white-space: normal;
}

.inspector-upgrade-button {
  margin-top: var(--sp-2);
}

/* Portrait: a sheet above the dock, the full width, its boxes in one column. */
.portrait .inspector-root {
  justify-content: flex-end;
  align-items: stretch;
}

.portrait .inspector-panel {
  width: auto;
  margin-top: 0;
  margin-bottom: var(--dock-lift);
}

.portrait .inspector-body {
  flex-direction: column;
}

/* In a column the boxes take their own height: a flex-basis of 0 (right for the two columns side by side) would squash them to nothing. */
.portrait .inspector-column {
  flex-grow: 0;
  flex-basis: auto;
}

.portrait .inspector-upgrade {
  margin: var(--sp-2) 0 0 0;
}
