/* The building inspector (M0-51, docs/how-to/add-ui-screen.md): a parchment panel at the right under the HUD, restyled in CR-0007. Colours and sizes come
   from Common.uss. It is two columns wide so that it fits under the HUD on a landscape phone: 400 high at most. */
.inspector-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
}

.inspector-panel {
  width: 390px;
  margin-top: var(--hud-height);
}

.inspector-panel--hidden {
  display: none;
}

.inspector-header {
  flex-direction: row;
  align-items: center;
}

.inspector-icon {
  width: 36px;
  height: 36px;
  margin-right: var(--sp-2);
  -unity-background-scale-mode: scale-to-fit;
}

.inspector-titles {
  flex-grow: 1;
  flex-shrink: 1;
}

.inspector-body {
  flex-direction: row;
  margin-top: var(--sp-2);
}

.inspector-column {
  flex-grow: 1;
  flex-basis: 0;
  flex-direction: column;
}

.inspector-status {
  color: var(--c-go);
}

.inspector-stepper {
  margin-top: var(--sp-2);
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.inspector-workers {
  min-width: 64px;
  color: var(--c-ink);
  font-size: var(--font-xl);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.inspector-upgrade {
  margin-left: var(--sp-3);
  padding-left: var(--sp-3);
  border-left-width: 2px;
  border-left-color: var(--c-parchment-3);
}

.inspector-step {
  font-size: var(--font-xl);
}

.inspector-close {
  margin-left: var(--sp-2);
}

.inspector-upgrade-button {
  margin-top: var(--sp-2);
}
