/* The building inspector (M0-51, docs/how-to/add-ui-screen.md): a panel at the right under the HUD. Sizes are in panel units (reference
   resolution 1200 x 800), so a 64 button is well over the 48 dp touch target. */
.inspector-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 16px;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
}

.inspector-panel {
  width: 440px;
  margin-top: 124px;
  padding: 12px;
  border-radius: 10px;
  background-color: rgba(0, 0, 0, 0.8);
}

.inspector-panel--hidden {
  display: none;
}

.inspector-header {
  flex-direction: row;
  align-items: center;
}

.inspector-icon {
  width: 64px;
  height: 64px;
  margin-right: 12px;
  -unity-background-scale-mode: scale-to-fit;
}

.inspector-titles {
  flex-grow: 1;
  flex-shrink: 1;
}

.inspector-name {
  color: rgb(255, 255, 255);
  font-size: 28px;
  -unity-font-style: bold;
  white-space: normal;
}

.inspector-status {
  margin-top: 8px;
  color: rgb(255, 214, 120);
  font-size: 24px;
  -unity-font-style: bold;
  white-space: normal;
}

.inspector-line {
  margin-top: 2px;
  color: rgb(225, 225, 225);
  font-size: 20px;
  white-space: normal;
}

.inspector-note {
  margin-top: 2px;
  color: rgb(255, 200, 90);
  font-size: 20px;
  white-space: normal;
}

.inspector-section {
  color: rgb(255, 255, 255);
  font-size: 24px;
  -unity-font-style: bold;
  white-space: normal;
}

.inspector-stepper {
  margin-top: 10px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.inspector-workers {
  min-width: 140px;
  color: rgb(255, 255, 255);
  font-size: 32px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.inspector-upgrade {
  margin-top: 12px;
  padding-top: 10px;
  border-top-width: 2px;
  border-top-color: rgb(80, 80, 80);
}

.inspector-button {
  min-height: 64px;
  margin: 0;
  padding: 8px 20px;
  border-radius: 8px;
  color: rgb(255, 255, 255);
  font-size: 26px;
  -unity-font-style: bold;
}

.inspector-button:disabled {
  opacity: 0.4;
}

.inspector-close {
  min-width: 64px;
  padding: 8px;
  background-color: rgb(110, 60, 56);
}

.inspector-step {
  min-width: 80px;
  font-size: 34px;
  background-color: rgb(60, 70, 90);
}

.inspector-upgrade-button {
  margin-top: 10px;
  background-color: rgb(46, 98, 56);
}
