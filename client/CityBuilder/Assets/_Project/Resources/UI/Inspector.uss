/* The building inspector (M0-51; visual v2, CR-0008-T2; centred and larger, CR-0008 D22): a parchment panel framed in wood in the middle of
   the screen, from under the HUD down over the faded dock, with boxes for the status and workers, the couriers and the upgrade: three columns side by side
   in landscape, one column in portrait. The body scrolls up and down only (OD-17); every text wraps, so nothing overlaps. Colours and sizes
   come from Common.uss. */
.inspector-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.inspector-panel {
  width: 90%;
  max-width: 1080px;
  max-height: 100%;
  margin-top: var(--hud-height);
  margin-bottom: var(--sp-2); /* over the dock: its buttons are faded and off while a building's menu is open (CR-0008 D22) */
  flex-shrink: 1;
  flex-direction: column;
}

.inspector-panel--hidden {
  display: none;
}

/* Every text of the panel wraps inside its box instead of running into the next one. */
.inspector-panel .unity-label {
  white-space: normal;
}

.inspector-header {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: var(--sp-2);
}

.inspector-icon {
  width: 72px;
  height: 72px;
  margin: -14px var(--sp-2) -6px -6px;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

.inspector-titles {
  flex-grow: 1;
  flex-shrink: 1;
}

.inspector-close {
  margin-left: var(--sp-2);
}

.inspector-scroll {
  flex-grow: 0;
  flex-shrink: 1;
  min-height: 0;
}

.inspector-body {
  flex-direction: row;
  align-items: flex-start;
}

.inspector-column {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 0;
  flex-direction: column;
}

/* The columns after the first keep a gap from the one before (USS has no sibling selector, so they are named). */
.inspector-courier-column,
.inspector-upgrade {
  margin-left: var(--sp-2);
}

.inspector-status-box {
  margin-bottom: var(--sp-2);
}

.inspector-status {
  color: var(--c-go-ink);
}

.inspector-store {
  margin-top: 2px;
  color: var(--c-ink);
}

.inspector-needs {
  margin-top: 2px;
  color: var(--c-warn-ink);
}

.inspector-trips,
.inspector-couriers {
  margin-top: 2px;
  color: var(--c-ink-soft);
}

.inspector-action {
  margin-top: var(--sp-2);
}

.inspector-routes-note {
  margin-top: var(--sp-1);
  color: var(--c-stop-ink);
}

/* One courier's work: its heading, a row per delivery line with its Cancel button, and Cancel all. */
.inspector-queues {
  flex-direction: column;
}

.inspector-queue {
  margin-top: var(--sp-2);
  padding: var(--sp-2);
}

.inspector-queue-title {
  color: var(--c-ink);
}

.inspector-queue-row {
  flex-direction: row;
  align-items: center;
  margin-top: var(--sp-1);
}

.inspector-queue-text {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  margin-right: var(--sp-2);
  color: var(--c-ink);
}

.inspector-queue-cancel {
  flex-shrink: 0;
  padding: 0 var(--sp-3);
}

.inspector-queue-cancel-all {
  margin-top: var(--sp-2);
}

.inspector-workers-box {
  flex-direction: column;
}

.inspector-stepper {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.inspector-step {
  width: var(--touch);
  padding: 0;
}

.inspector-workers {
  -unity-font-definition: url("Fonts/Fredoka-SemiBold.ttf");
  min-width: 76px;
  color: var(--c-ink);
  font-size: var(--font-xxl);
  -unity-text-align: middle-center;
}

.inspector-preview {
  margin-top: var(--sp-1);
  -unity-text-align: middle-center;
}

.inspector-upgrade-cost {
  -unity-font-definition: url("Fonts/Fredoka-SemiBold.ttf");
  margin-top: 2px;
  color: var(--c-ink);
  font-size: var(--font-md);
}

.inspector-upgrade-time {
  padding-left: 18px;
  background-size: 14px 14px;
  background-repeat: no-repeat no-repeat;
  background-position-x: left 0px;
  background-position-y: center;
  -unity-background-image-tint-color: var(--c-ink-soft);
}

.inspector-upgrade-note {
  -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
  margin-top: 2px;
  color: var(--c-stop-ink);
  font-size: var(--font-sm);
}

.inspector-upgrade-button {
  margin-top: var(--sp-2);
}

/* Portrait: the full width under the HUD, the boxes in one column. */
.portrait .inspector-panel {
  width: 100%;
}

.portrait .inspector-body {
  flex-direction: column;
  align-items: stretch;
}

/* In a column the boxes take their own height: a flex-basis of 0 (right for the columns side by side) would squash them to nothing. */
.portrait .inspector-column {
  flex-grow: 0;
  flex-basis: auto;
}

.portrait .inspector-courier-column,
.portrait .inspector-upgrade {
  margin: var(--sp-2) 0 0 0;
}
