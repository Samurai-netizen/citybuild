<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <!-- One action of a stop in the route editor (CR-0008-T2 part C; compact since M0-C): RouteEditorScreen clones it once per action. Three
       buttons that each change one thing on a tap (take or put, the item, the amount; the item gets the most room) and the one that removes
       the action. Style: RouteEditor.uss. -->
  <ui:VisualElement name="route-action" class="route-action">
    <ui:Button name="route-action-kind" class="route-action-button route-action-kind route-compact btn btn--quiet" text="Take" />
    <ui:Button name="route-action-item" class="route-action-button route-action-item route-compact btn btn--quiet" text="Logs" />
    <ui:Button name="route-action-amount" class="route-action-button route-action-amount route-compact btn btn--quiet" text="All" />
    <ui:Button name="route-action-remove" class="route-action-remove route-compact btn btn--danger glyph glyph-minus" text="" />
  </ui:VisualElement>
</ui:UXML>
