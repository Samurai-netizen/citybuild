/* The placement bar (docs/how-to/add-ui-screen.md): a panel at the bottom right, opposite the Build button. M0-46. Sizes are in panel units
   (reference resolution 1200 x 800), so a 64 button is well over the 48 dp touch target. */
.placement-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 16px;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
}

.placement-panel {
  width: 460px;
  padding: 12px;
  border-radius: 10px;
  background-color: rgba(0, 0, 0, 0.8);
}

.placement-panel--hidden {
  display: none;
}

.placement-prompt {
  color: rgb(255, 255, 255);
  font-size: 24px;
  -unity-font-style: bold;
  white-space: normal;
}

.placement-hint {
  margin-top: 4px;
  color: rgb(255, 200, 90);
  font-size: 20px;
  white-space: normal;
}

.placement-error {
  margin-top: 4px;
  color: rgb(255, 130, 110);
  font-size: 20px;
  white-space: normal;
}

.placement-buttons {
  margin-top: 10px;
  flex-direction: row;
  justify-content: flex-end;
}

.placement-button {
  min-width: 140px;
  min-height: 64px;
  margin: 0 0 0 12px;
  padding: 8px 20px;
  border-radius: 8px;
  color: rgb(255, 255, 255);
  font-size: 26px;
  -unity-font-style: bold;
}

.placement-cancel {
  background-color: rgb(110, 60, 56);
}

.placement-place {
  background-color: rgb(46, 98, 56);
}

.placement-button:disabled {
  opacity: 0.4;
}
