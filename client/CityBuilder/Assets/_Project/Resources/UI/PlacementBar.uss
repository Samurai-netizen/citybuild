/* The placement bar (docs/how-to/add-ui-screen.md): a parchment panel at the bottom right, opposite the Build button. M0-46, restyled in CR-0007.
   Colours and sizes come from Common.uss. */
.placement-root {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-2); /* replaced by the safe area in code */
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-end;
}

.placement-panel {
  width: 280px;
  max-width: 100%;
}

/* Portrait (M0-59): at the bottom right the bar would cover the Research button (116 to 216 units from the left), so it sits above the dock. */
.portrait .placement-panel {
  margin-bottom: var(--dock-lift);
}

.placement-panel--hidden {
  display: none;
}

.placement-hint {
  margin-top: var(--sp-1);
}

.placement-error {
  margin-top: var(--sp-1);
  color: var(--c-stop);
  font-size: var(--font-sm);
  -unity-font-style: bold;
  white-space: normal;
}

.placement-buttons {
  margin-top: var(--sp-2);
  flex-direction: row;
  justify-content: flex-end;
}

.placement-button {
  min-width: 96px;
  margin: 0 0 0 var(--sp-2);
}
